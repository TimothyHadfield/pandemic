{
  "repo": "pandemic",
  "ready": "document.querySelector('#v-play.on [data-start], #v-play.on #g-acts') !== null",
  "play": [
    "try { localStorage.setItem('coach-offer:pandemic-first', '1'); document.querySelectorAll('.coach-offer').forEach(x => x.remove()); } catch (e) {}",
    "document.querySelector('[data-start]') && document.querySelector('[data-start]').click()",
    "(() => { const b = document.querySelector('#g-acts [data-g=\"end\"]'); if (b) b.click(); })()",
    "(() => { const b = document.querySelector('.confirm-back [data-c=\"yes\"]'); if (b) b.click(); })()"
  ],
  "played": "(() => { const g = JSON.parse(localStorage.getItem('pandemic-lab-v1') || '{}').game; return !!g && !!g.state && (g.state.turn > 1 || g.state.cur !== g.me) && !g.state.over && document.querySelector('#g-acts') !== null; })()",
  "debug": "JSON.stringify((JSON.parse(localStorage.getItem('pandemic-lab-v1') || '{}').game || {}).state && { turn: JSON.parse(localStorage.getItem('pandemic-lab-v1')).game.state.turn, cur: JSON.parse(localStorage.getItem('pandemic-lab-v1')).game.state.cur })",
  "safe": "document.querySelector('#tabs [data-tab=\"study\"]').click()"
}
